{
  "manifest_version": 3,
  "name": "DeepSeek 网页桥接（自研）",
  "version": "1.0.11",
  "description": "把本机中转站/Harness 的任务送到已登录的 DeepSeek 网页，再把答复原文带回来。只搬运文本，不解析、不上传任何凭据。",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": ["http://127.0.0.1:3081/*", "https://chat.deepseek.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["clock.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["dom.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "DeepSeek 网页桥接（自研）",
    "default_popup": "popup.html"
  }
}
